# Google Gemini API Key for Multimodal Document Vision & Q&A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OCR Configuration (tesseract, cloud, or native)
OCR_PROVIDER=tesseract
OCR_API_KEY=
TESSERACT_CMD=

# Database URL
# For local instant SQLite (dev default):
DATABASE_URL=sqlite+aiosqlite:///./docintel.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docintel

# Storage Path
FILE_STORAGE_PATH=./storage

# Confidence Threshold (fields below this are flagged for human review)
CONFIDENCE_THRESHOLD=0.75
