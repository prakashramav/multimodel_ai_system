# Anthropic API Key for multimodal Claude Vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OCR Configuration (tesseract, cloud, or native)
OCR_PROVIDER=tesseract
OCR_API_KEY=
TESSERACT_CMD=

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./docintel.db

# Storage Path
FILE_STORAGE_PATH=./storage

# Confidence Threshold (fields below this are flagged for human review)
CONFIDENCE_THRESHOLD=0.75
